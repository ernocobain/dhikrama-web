---
import Layout from '../layouts/Layout.astro';

const title = "About — Dhikrama";
const description = "Learn more about Dhikrama, a full-stack developer specializing in Android, modern web, and cloud APIs.";
---

<Layout title={title} description={description}>
  <section class="hero">
    <div class="container stack">
      <span class="eyebrow">About Me</span>
      <h1>Hi, I'm Dhikrama.</h1>
      <p class="lead">
        I'm a full-stack developer from Indonesia, specializing in Android apps, modern web, and cloud APIs. I build complete products — from idea to deployment.
      </p>
    </div>
  </section>

  <section class="section soft-section" aria-labelledby="background">
    <div class="narrow stack-lg">
      <span class="eyebrow">Background</span>
      <h2 id="background">3+ years of building digital products.</h2>
      <p>
        My journey in software development has been focused on building practical, high-performance applications. I have extensive experience in the Android ecosystem (Kotlin, Jetpack Compose) and modern web technologies (Astro, TypeScript, Vue).
      </p>
      <p>
        I've successfully delivered various projects, including a full-stack logistics platform with real-time tracking, an AI-powered video editor for Android, and several high-performance business websites. I enjoy taking full ownership of the development lifecycle, from architecture and UI design to cloud infrastructure and deployment.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="approach">
    <div class="container grid grid-2">
      <div class="stack">
        <span class="eyebrow">Approach</span>
        <h2 id="approach">How I work.</h2>
        <p>I believe in building software that is not just functional, but also maintainable and scalable.</p>
      </div>
      <ol class="numbered">
        <li>
          <strong>End-to-end ownership.</strong><br />
          I handle everything from frontend development and mobile apps to backend APIs and cloud deployment.
        </li>
        <li>
          <strong>Ship fast, iterate.</strong><br />
          I focus on delivering a high-quality MVP (Minimum Viable Product) quickly, then improving it based on real-world feedback.
        </li>
        <li>
          <strong>Clean, maintainable code.</strong><br />
          I prioritize solid architecture (like Clean Architecture on Android) to ensure the codebase remains scalable and easy to maintain.
        </li>
      </ol>
    </div>
  </section>

  <section class="section soft-section" aria-labelledby="availability">
    <div class="narrow panel stack" style="text-align: center;">
      <span class="eyebrow" style="margin: 0 auto;">Availability</span>
      <h2 id="availability">Available for freelance worldwide.</h2>
      <p class="lead">
        I am remote-friendly and open to both short-term and long-term engagements. Whether you're a startup looking to build an MVP or an established business needing a specialized developer — let's talk.
      </p>
      <div class="button-row" style="justify-content: center;">
        <a class="button primary" href="/contact">Contact Me</a>
        <a class="button secondary" href="/work">View My Work</a>
      </div>
    </div>
  </section>
</Layout>
