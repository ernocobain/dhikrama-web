---
import Layout from '../layouts/Layout.astro';

const title = "Contact — Dhikrama";
const description = "Get in touch for freelance inquiries, project collaborations, or just to say hi.";
---

<Layout title={title} description={description}>
  <section class="hero">
    <div class="container stack">
      <span class="eyebrow">Contact</span>
      <h1>Let's work together.</h1>
      <p class="lead">Have a project in mind? I'd love to hear about it. Reach out directly or use the information below.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-info">
    <div class="container grid grid-2">
      <div class="stack">
        <div class="card">
          <h3>Email</h3>
          <p><a href="mailto:hello@dhikrama.com" class="lead" style="font-weight: 700;">hello@dhikrama.com</a></p>
        </div>
        <div class="card">
          <h3>WhatsApp</h3>
          <p><a href="https://wa.me/6288233761607" class="lead" style="font-weight: 700;" rel="noopener noreferrer">+62 882-3376-1607</a></p>
        </div>
        <div class="card">
          <h3>Response Time</h3>
          <p class="lead">I typically respond within 24 hours.</p>
        </div>
      </div>
      
      <aside class="panel stack">
        <h2 class="h3">What to include in your message:</h2>
        <ol class="numbered">
          <li>Project description and goals</li>
          <li>Timeline and budget range</li>
          <li>Tech stack preferences (if any)</li>
          <li>Any reference apps or websites</li>
        </ol>
        <div class="button-row" style="margin-top: 1.5rem;">
          <a href="mailto:hello@dhikrama.com" class="button primary">Send Email</a>
          <a href="https://github.com/dhikrama" class="button secondary" rel="noopener noreferrer">View GitHub</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
