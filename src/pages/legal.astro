---
import Layout from '../layouts/Layout.astro';

const title = 'Legal — Dhikrama';
const description = 'Legal disclaimer for Dhikrama, a full-stack developer portfolio.';
---

<Layout title={title} description={description} canonicalPath="/legal">
  <section class="hero">
    <div class="narrow stack-lg">
      <span class="eyebrow">Legal</span>
      <h1>Portfolio disclaimer.</h1>
      <p class="lead">
        A simple disclaimer explaining the nature of this portfolio and the projects featured.
      </p>
    </div>
  </section>

  <section class="section soft-section">
    <div class="narrow panel stack">
      <h2>Disclaimer</h2>
      <p>
        Dhikrama is the personal brand and portfolio of a full-stack developer. The projects featured on this website are for demonstration and portfolio purposes.
      </p>
      <p>
        Some projects may be independent entities, client work, or personal ventures. Each project may operate with its own brand, terms of service, and privacy policy.
      </p>
      <div class="button-row">
        <a class="button primary" href="/work">View My Work</a>
        <a class="button secondary" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Layout>
