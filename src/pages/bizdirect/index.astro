---
import Layout from '../../layouts/Layout.astro';

const title = 'BizDirect — Kelola Google Business Profile Anda';
const description = 'Aplikasi resmi BizDirect oleh Dhikrama untuk mempermudah pengelolaan Google Business Profile UMKM langsung dari perangkat Anda.';
---

<Layout title={title} description={description} canonicalPath="/bizdirect">
  <section class="hero">
    <div class="narrow stack-lg">
      <span class="eyebrow">Aplikasi Mobile</span>
      <h1>BizDirect</h1>
      <p class="lead">
        Cara termudah untuk mengelola Google Business Profile UMKM Anda. Update info toko, terbitkan promo, dan balas ulasan pelanggan dalam satu sentuhan.
      </p>
      <div class="button-row">
        <a class="button primary" href="/bizdirect/kebijakan-privasi">Kebijakan Privasi</a>
        <a class="button secondary" href="/bizdirect/syarat-dan-ketentuan">Syarat & Ketentuan</a>
      </div>
    </div>
  </section>
  <section class="section soft-section">
    <div class="narrow panel stack" style="gap: 24px;">
      <h2>Tentang BizDirect</h2>
      <p>
        BizDirect adalah aplikasi pihak ketiga yang terintegrasi secara aman dengan API Google Business Profile untuk memudahkan Anda (pemilik bisnis) dalam mengelola kehadiran digital toko Anda di Google Search dan Google Maps.
      </p>
      <p>
        Dibuat dan dikelola oleh <strong>Dhikrama</strong>.
      </p>
      <h3>Fitur Utama:</h3>
      <ul>
        <li>Manajemen Lokasi Bisnis</li>
        <li>Buka / Tutup Toko Secara Real-time</li>
        <li>Pembuatan Postingan dan Promo</li>
        <li>Balas Ulasan Pelanggan Terpusat</li>
        <li>Laporan Analitik Mingguan Terpadu</li>
      </ul>
      <p style="margin-top: 24px;">
        <strong>Dukungan Pengguna:</strong><br/>
        Jika Anda memiliki pertanyaan atau kendala terkait aplikasi ini, silakan hubungi <a href="mailto:hello@dhikrama.com">hello@dhikrama.com</a>.
      </p>
    </div>
  </section>
</Layout>
