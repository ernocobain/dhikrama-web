---
import Layout from '../layouts/Layout.astro';
import TechBadge from '../components/TechBadge.astro';
import { workProjects } from '../data/projects';

const featuredProjects = workProjects.slice(0, 2);
---

<Layout>
  <!-- SECTION 1 — HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">AVAILABLE FOR FREELANCE</span>
        <h1>I build Android apps, web apps, and cloud APIs that ship fast.</h1>
        <p class="lead">
          Full-stack developer specializing in Android (Kotlin, Jetpack Compose), modern web (Astro, TypeScript), and serverless APIs (Cloudflare Workers, Firebase).
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/work">View My Work</a>
          <a class="button secondary" href="/contact">Get In Touch</a>
        </div>
      </div>
      <aside class="panel stack" aria-labelledby="quick-stats">
        <span class="eyebrow">Quick Stats</span>
        <h2 id="quick-stats" class="h3">Expertise at a glance.</h2>
        <ul class="plain-list">
          <li><strong>4+</strong> projects shipped end-to-end</li>
          <li><strong>3+</strong> years professional experience</li>
          <li>Android + Web + Cloud focus</li>
          <li>Remote-friendly worldwide</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- SECTION 2 — TECH STACK -->
  <section class="section soft-section" aria-labelledby="tech-stack">
    <div class="container stack-lg">
      <div class="stack">
        <span class="eyebrow">Tech Stack</span>
        <h2 id="tech-stack">Tools I use to build production-ready software.</h2>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <h3>Android</h3>
          <p>Native development with modern tools for performance and scale.</p>
          <TechBadge techs={["Kotlin", "Jetpack Compose", "Media3", "WorkManager", "Room DB", "Coroutines"]} />
        </div>
        <div class="card">
          <h3>Web</h3>
          <p>Fast, SEO-optimized frontends using the latest frameworks.</p>
          <TechBadge techs={["Astro", "TypeScript", "Vue 3", "Tailwind CSS", "Vite"]} />
        </div>
        <div class="card">
          <h3>Cloud & Backend</h3>
          <p>Scalable, low-latency infrastructure and serverless APIs.</p>
          <TechBadge techs={["Cloudflare Workers", "Hono.js", "Firebase", "D1", "REST APIs"]} />
        </div>
        <div class="card">
          <h3>AI & Agents</h3>
          <p>Autonomous AI systems and agentic workflows for automation.</p>
          <TechBadge techs={["LLM Orchestration", "Multi-Agent Systems (CrewAI)", "MCP", "RAG Pipelines", "Vector Search", "Autonomous Workflows", "Hermes Framework"]} />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — FEATURED WORK -->
  <section class="section" aria-labelledby="featured-work">
    <div class="container stack-lg">
      <div class="stack">
        <span class="eyebrow">Featured Work</span>
        <h2 id="featured-work">Recent projects I've built end-to-end.</h2>
      </div>
      <div class="grid grid-2">
        {featuredProjects.map((project) => (
          <article class="card project-card">
            <div class="stack">
              <h3>{project.name} <br/> <small style="font-weight: 500; font-size: 0.9rem; color: var(--muted);">{project.subtitle}</small></h3>
              <p>{project.summary}</p>
              <TechBadge techs={project.techStack.slice(0, 4)} />
            </div>
            <div class="button-row">
              <a class="button secondary" href={`/work/${project.slug}`}>View Case Study</a>
              {project.url && (
                <a class="button primary" href={project.url} rel="noopener noreferrer">
                  {project.slug === 'ngeditapp' ? 'View on GitHub' : 'Live Demo'}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 2rem;">
        <a href="/work" class="button secondary">View all work →</a>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — SERVICES -->
  <section class="section soft-section" aria-labelledby="services">
    <div class="container stack-lg">
      <div class="stack">
        <span class="eyebrow">What I Offer</span>
        <h2 id="services">Services I provide as a freelance developer.</h2>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <h3>Android App Development</h3>
          <p>Native Android apps with Jetpack Compose, Media3, and modern architecture. From concept to Play Store.</p>
        </div>
        <div class="card">
          <h3>Web Apps & Landing Pages</h3>
          <p>Fast, SEO-optimized websites and web apps using Astro, Vue, and Tailwind. Built for performance.</p>
        </div>
        <div class="card">
          <h3>API & Cloud Infrastructure</h3>
          <p>Serverless APIs on Cloudflare Workers, Firebase integration, and scalable backend architecture.</p>
        </div>
        <div class="card">
          <h3>Full-Stack Products</h3>
          <p>End-to-end development — frontend, backend, cloud, and deployment. One developer, complete solution.</p>
        </div>
        <div class="card">
          <h3>Agentic AI Engineering</h3>
          <p>Autonomous AI systems that plan, reason, and execute tasks. Multi-agent orchestration, tool-use pipelines, and agentic workflows — from research agents to autonomous coding systems.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 5 — CTA -->
  <section class="section" aria-labelledby="cta">
    <div class="narrow panel stack" style="text-align: center;">
      <h2 id="cta">Let's build something together.</h2>
      <p class="lead">
        I'm available for freelance projects worldwide. Whether you need an Android app, a fast website, or a complete product — let's talk.
      </p>
      <div class="button-row" style="justify-content: center;">
        <a class="button primary" href="/contact">Contact Me</a>
        <a class="button secondary" href="/work">View My Work</a>
      </div>
    </div>
  </section>
</Layout>
